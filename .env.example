# 複製這個檔案，改名成 .env，再填入下面的值
# .env 裡有金鑰，不要傳給別人

# Discord Developer Portal → 你的應用程式 → Bot → Reset Token
DISCORD_TOKEN=

# 模型的 OpenAI 相容 API 位址（例如 LiteLLM / Ollama）
LLM_BASE_URL=http://localhost:4000/v1
# 模型 API 的金鑰
LLM_API_KEY=
LLM_MODEL=qwen

# none = 不思考直接回（快）；想要它想久一點可改 low / medium / high
REASONING_EFFORT=none

# 等模型回覆最多幾秒
LLM_TIMEOUT=300

# 回覆前讀取最近幾則頻道訊息當上下文（越多越懂前後文，但模型處理越久）
HISTORY_LIMIT=30

# 每次回覆的長度上限（token）
MAX_TOKENS=1500

# 在這些頻道裡，任何人發言機器人都會回（不用 @它）
# 頻道 ID 用逗號分開；留空代表只在被 @ 或私訊時才回
# 取得頻道 ID：Discord 設定 → 進階 → 開啟開發者模式，再對頻道按右鍵 → 複製頻道 ID
AUTO_REPLY_CHANNEL_IDS=

# 叫 Ollama 模型保持載入多久（預設 24h；空白＝用 Ollama 預設的 5 分鐘）
LLM_KEEP_ALIVE=24h
# 查 DeepSeek 餘額用（選填，給 /餘額 指令）
DEEPSEEK_API_KEY=
# 線上模型（deepseek）的思考程度：none = 不思考（省錢，預設）；空白 = 不送參數，DeepSeek 會自己思考、費用約多 3~4 倍
REMOTE_REASONING_EFFORT=none

# 畫圖（走 LiteLLM 的 /v1/images/generations；沒設就沿用上面的 LLM_BASE_URL / LLM_API_KEY）
# IMAGE_GEN=on
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
# IMAGE_MAX_QUEUE=4
# 智慧畫圖（/智慧畫圖）擴寫提示詞用的模型；沒設就用 LiteLLM 上的 prompt-writer
# IMAGE_PROMPT_MODEL=prompt-writer
# 畫圖／改圖預設只能在年齡限制（NSFW）頻道使用；設成 off 就不限頻道
# IMAGE_NSFW_ONLY=on

# Discord Activity（網頁小遊戲）
# 前端用：Discord Application ID（公開資訊，不是密鑰）
VITE_CLIENT_ID=
# 真代幣模式登入用的 OAuth 密鑰（Developer Portal → OAuth2 → Client Secret），只有 Activity 後端讀得到
DISCORD_CLIENT_SECRET=

# ---- Activity 相關（都有預設值，同一台機器不用設）
# ACTIVITY_API=http://127.0.0.1:3101    # 機器人去問 Activity 後端（誰在玩什麼）的位址
# BOT_API_PORT=3107                     # 機器人給 Activity 後端用的內部 API 連接埠（Activity 那邊用 BOT_API 指到它）

# ---- 阿瓦隆「電腦用 AI 思考」（沒設就沿用上面的 LLM_BASE_URL / LLM_API_KEY，模型用機器人目前選的）
# AVALON_LLM_ENABLE=1           # 阿瓦隆「電腦用 AI 思考」總開關，預設關閉；設 1 才會在大廳出現選項
# AVALON_LLM_BASE_URL=
# AVALON_LLM_API_KEY=
# AVALON_LLM_MODEL=              # 想固定用某個模型時才設
# AVALON_LLM_REASONING=none      # 思考模式：none 不思考（預設，快又省）；填 low／medium／high 或留空
# AVALON_LLM_TIMEOUT=60          # 單次思考最久幾秒，超過就退回規則

# 英雄聯盟世界賽運彩（Activity「世界賽運彩」）：賠率從 OddsPapi 取得，有 API 額度限制，所以只有「有人開著頁面」才會更新
# ODDSPAPI_KEY=                  # 到 oddspapi.io 註冊取得；沒設就不啟用
# LOLBET_BUDGET=195             # 從現在起最多可呼叫 OddsPapi 幾次（免費額度 250 次，已用掉的先扣）
# LOLBET_RESERVE=45             # 其中專留給結算賽果的次數
# LOLBET_END=2026-11-16T00:00:00+08:00   # 世界賽結束時間，額度會平均分配到這天
# LOLBET_BOOKMAKER=pinnacle      # 參考哪一家的盤口
# LOLBET_TOURNAMENT=2549         # 賽事代號（2549＝世界賽）
