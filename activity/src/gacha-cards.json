[{"id":1,"name":"應龍","rarity":"SSR","type":"神獸","desc":"上古翼龍,能蓄水興雨,曾助黃帝戰蚩尤。"},{"id":2,"name":"鳳凰","rarity":"SSR","type":"神獸","desc":"百鳥之王,浴火而生,所過之處萬物回春。"},{"id":3,"name":"麒麟","rarity":"SSR","type":"神獸","desc":"仁獸現世,天下太平。"},{"id":4,"name":"嫦娥","rarity":"SSR","type":"人物","desc":"偷服仙藥,飛升月宮,一世清冷。"},{"id":5,"name":"崑崙仙山","rarity":"SSR","type":"山水","desc":"萬山之祖,諸神所居,凡人不得見。"},{"id":6,"name":"九尾狐","rarity":"SR","type":"神獸","desc":"千年修行,九尾既成,能迷人心魄。"},{"id":7,"name":"白澤","rarity":"SR","type":"神獸","desc":"通曉萬物,識盡天下妖怪之名。"},{"id":8,"name":"玄武","rarity":"SR","type":"神獸","desc":"北方守護,龜蛇合體,沉穩不可撼動。"},{"id":9,"name":"白虎","rarity":"SR","type":"神獸","desc":"西方守護,殺伐之氣,百獸皆避。"},{"id":10,"name":"劍仙","rarity":"SR","type":"人物","desc":"一劍光寒,千里取人頭顱於談笑間。"},{"id":11,"name":"紅衣俠女","rarity":"SR","type":"人物","desc":"一襲紅衣,劍出無悔,江湖路遠。"},{"id":12,"name":"軒轅劍","rarity":"SR","type":"器物","desc":"黃帝所佩,斬妖除魔,神器之首。"},{"id":13,"name":"蓬萊雲海","rarity":"SR","type":"山水","desc":"海上仙山,雲霧深處,有人長生。"},{"id":14,"name":"飛流瀑布","rarity":"SR","type":"山水","desc":"飛流直下三千尺,疑是銀河落九天。"},{"id":15,"name":"深山古道","rarity":"SR","type":"山水","desc":"人跡罕至,唯有雲與松為伴。"},{"id":16,"name":"饕餮","rarity":"R","type":"神獸","desc":"貪食之獸,吞盡一切,連自己也吞下。"},{"id":17,"name":"貔貅","rarity":"R","type":"神獸","desc":"吞金納財,只進不出。"},{"id":18,"name":"畢方","rarity":"R","type":"神獸","desc":"一足之鳥,所到之處必有火災。"},{"id":19,"name":"青鸞","rarity":"R","type":"神獸","desc":"鳳凰之屬,鳴聲清越,傳遞仙訊。"},{"id":20,"name":"刀客","rarity":"R","type":"人物","desc":"一刀在手,萬里獨行。"},{"id":21,"name":"琴師","rarity":"R","type":"人物","desc":"高山流水,知音難覓。"},{"id":22,"name":"道士","rarity":"R","type":"人物","desc":"煉丹問道,不問人間事。"},{"id":23,"name":"僧人","rarity":"R","type":"人物","desc":"一缽一杖,行遍山川。"},{"id":24,"name":"漁翁","rarity":"R","type":"人物","desc":"孤舟蓑笠翁,獨釣寒江雪。"},{"id":25,"name":"古琴","rarity":"R","type":"器物","desc":"七弦清響,可通天地。"},{"id":26,"name":"銅鏡","rarity":"R","type":"器物","desc":"鏡中照見的,不只是容顏。"},{"id":27,"name":"竹林","rarity":"R","type":"山水","desc":"竹影搖風,清氣滿林。"},{"id":28,"name":"寒江獨釣","rarity":"R","type":"山水","desc":"千山鳥飛絕,萬徑人蹤滅。"},{"id":29,"name":"古寺晨鐘","rarity":"R","type":"山水","desc":"一聲鐘響,山中日月長。"},{"id":30,"name":"仙鶴","rarity":"N","type":"神獸","desc":"長壽之鳥,姿態悠然。"},{"id":31,"name":"錦鯉","rarity":"N","type":"神獸","desc":"魚躍龍門的第一步。"},{"id":32,"name":"白鹿","rarity":"N","type":"神獸","desc":"仙山靈獸,遇之者吉。"},{"id":33,"name":"玄貓","rarity":"N","type":"神獸","desc":"夜裡的眼睛,什麼都看見了。"},{"id":34,"name":"寒鴉","rarity":"N","type":"神獸","desc":"枯藤老樹昏鴉。"},{"id":35,"name":"蟾蜍","rarity":"N","type":"神獸","desc":"月中蟾蜍,吐錢招財。"},{"id":36,"name":"書童","rarity":"N","type":"人物","desc":"跟著先生走遍天涯。"},{"id":37,"name":"樵夫","rarity":"N","type":"人物","desc":"砍柴聽松,日子也夠了。"},{"id":38,"name":"牧童","rarity":"N","type":"人物","desc":"牧童遙指杏花村。"},{"id":39,"name":"採蓮女","rarity":"N","type":"人物","desc":"荷花深處,有人唱歌。"},{"id":40,"name":"說書人","rarity":"N","type":"人物","desc":"一塊驚堂木,說盡天下事。"},{"id":41,"name":"油紙傘","rarity":"N","type":"器物","desc":"雨巷深處,等一個人。"},{"id":42,"name":"毛筆","rarity":"N","type":"器物","desc":"一筆一畫,皆是功夫。"},{"id":43,"name":"酒葫蘆","rarity":"N","type":"器物","desc":"一壺濁酒,盡歡而已。"},{"id":44,"name":"燈籠","rarity":"N","type":"器物","desc":"夜路長,有光就不怕。"},{"id":45,"name":"竹笛","rarity":"N","type":"器物","desc":"一曲短笛,山谷回聲。"},{"id":46,"name":"茶壺","rarity":"N","type":"器物","desc":"一壺清茶,半日浮生。"},{"id":47,"name":"梅花","rarity":"N","type":"山水","desc":"凌寒獨自開。"},{"id":48,"name":"荷塘","rarity":"N","type":"山水","desc":"出淤泥而不染。"},{"id":49,"name":"紙鳶","rarity":"N","type":"器物","desc":"春風一起,線在誰手。"},{"id":50,"name":"遠山松雲","rarity":"N","type":"山水","desc":"遠山如黛,松下聽雲。"}]